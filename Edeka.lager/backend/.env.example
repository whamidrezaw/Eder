# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
# DOMAIN دیگر برای CORS لازم نیست (هر Origin پذیرفته می‌شود چون احراز هویت
# با Bearer Token است نه کوکی). فقط برای مرجع/آینده نگه داشته شده.
DOMAIN=https://deine-domain.de

# پشت یک reverse proxy واقعی (nginx, Caddy, ...) هستید؟ روی true بگذارید
# تا IP واقعی کلاینت (نه IP پروکسی) برای rate-limiting و لاگ ورود استفاده شود.
TRUST_PROXY=false

# ── Datenbank ───────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/edeka-lager

# ── Authentifizierung ───────────────────────────────
# با دستور زیر یک مقدار تصادفی و امن بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ein-sehr-langer-zufaelliger-string-hier-einfuegen
JWT_EXPIRES_IN=7d

# ── Telegram-Bericht (Bot-Token + Chat-ID des Kanals/Gruppe/Bots) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Nur für: npm run create-admin (ohne Passwort-Argument) ──
# Wenn leer: createAdmin.js bricht mit einer Fehlermeldung ab, statt einen
# schwachen Standardwert zu benutzen. Alternativ: node createAdmin.js admin IhrPasswort
ADMIN_PASSWORD=
